[Unit]
Description=Gunicorn instance to serve flaskapp
After=network.target

[Service]
User=root
Group=nginx
WorkingDirectory=/root/flasktask
Environment="PATH=/root/deploymentvenv/venv/bin"
ExecStart=/root/flasktask/deploymentvenv/bin/python run.py

[Install]
WantedBy=multi-user.target

 


 server {
    listen 80;
    server_name localhost;

    location / {
        include proxy_params;
        proxy_pass http://;
    }
}




server {
    listen 80;
    server_name localhost;

    location / {
        proxy_pass http://unix:/root/flasktask/flaskapp.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static {
        alias /root/flasktask/static;
    }
}